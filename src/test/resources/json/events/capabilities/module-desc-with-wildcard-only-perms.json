{
  "id": "foo-module-1.0.0",
  "name": "Foo Service",
  "provides": [
    {
      "id": "foo-interface",
      "version": "0.1",
      "handlers": [
        {
          "methods": [ "GET" ],
          "pathPattern": "/foo/{id}",
          "permissionsRequired": [ "*" ]
        }
      ]
    }
  ],
  "permissionSets": [
    {
      "permissionName": "foo.item.get",
      "displayName": "foo.item.get display name",
      "description": "foo.item.get description"
    }
  ]
}
